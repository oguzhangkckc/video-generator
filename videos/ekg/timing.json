{
  "source": "elevenlabs:Xb7hH8MSUJpSbSDYk0k2/eleven_multilingual_v2",
  "audio": "videos/ekg/vo.wav",
  "phrases": [
    {
      "text": "Bu çizgiyi mutlaka görmüşsündür.",
      "start": 0.2,
      "end": 1.79
    },
    {
      "text": "Ama okumayı kimse öğretmedi.",
      "start": 1.92,
      "end": 3.32
    },
    {
      "text": "Bu çizgi ne anlatıyor?",
      "start": 3.45,
      "end": 4.8
    },
    {
      "text": "Peki cihaz bunu nasıl duyuyor?",
      "start": 5.2,
      "end": 6.65
    },
    {
      "text": "Göğsündeki elektrotlarla.",
      "start": 6.79,
      "end": 7.99
    },
    {
      "text": "Kalbinin akımı cildine ulaşıyor:",
      "start": 8.18,
      "end": 9.56
    },
    {
      "text": "kalem pilin binde birinden az.",
      "start": 9.65,
      "end": 11.26
    },
    {
      "text": "Cihazın kendi akımı ise",
      "start": 11.45,
      "end": 12.49
    },
    {
      "text": "hissedemeyeceğin kadar küçük.",
      "start": 12.59,
      "end": 14.15
    },
    {
      "text": "Peki bu akım nereden geliyor?",
      "start": 14.5,
      "end": 15.88
    },
    {
      "text": "Kalbinin sağ üst köşesinden.",
      "start": 15.99,
      "end": 17.57
    },
    {
      "text": "Bir hücre kümesi ateşleniyor:",
      "start": 17.72,
      "end": 19.2
    },
    {
      "text": "dakikada altmış ila yüz kez.",
      "start": 19.28,
      "end": 21.02
    },
    {
      "text": "Dalga kulakçıklara yayılırken",
      "start": 21.2,
      "end": 22.36
    },
    {
      "text": "ilk küçük tepe çiziliyor: P.",
      "start": 22.46,
      "end": 24.45
    },
    {
      "text": "Peki ardından neden düz gidiyor?",
      "start": 24.8,
      "end": 26.58
    },
    {
      "text": "Dalga tek bir kapıda bekliyor:",
      "start": 26.73,
      "end": 28.41
    },
    {
      "text": "saniyenin onda biri kadar.",
      "start": 28.57,
      "end": 29.99
    },
    {
      "text": "Kan aşağı dolsun diye.",
      "start": 30.14,
      "end": 31.47
    },
    {
      "text": "Bu düzlük, PR bölümü.",
      "start": 31.61,
      "end": 33.25
    },
    {
      "text": "Peki o büyük sivri tepe ne?",
      "start": 33.6,
      "end": 34.91
    },
    {
      "text": "Kapı açılıyor, dalga hızlanıyor;",
      "start": 34.99,
      "end": 36.52
    },
    {
      "text": "karıncıklar birden uyarılıyor.",
      "start": 36.59,
      "end": 38.19
    },
    {
      "text": "İşte QRS: asıl vuruşun işareti.",
      "start": 38.34,
      "end": 40.54
    },
    {
      "text": "Kas bir an sonra kasılıyor.",
      "start": 40.66,
      "end": 41.95
    },
    {
      "text": "Sonra toparlanma dalgası: T.",
      "start": 42.03,
      "end": 43.85
    },
    {
      "text": "Küçük tepe: kulakçıklar,",
      "start": 44.2,
      "end": 45.67
    },
    {
      "text": "düzlük: bekleme,",
      "start": 45.71,
      "end": 46.65
    },
    {
      "text": "sivri tepe: karıncıklar,",
      "start": 46.69,
      "end": 48.02
    },
    {
      "text": "son dalga: toparlanma.",
      "start": 48.08,
      "end": 49.49
    },
    {
      "text": "Bunun adı:",
      "start": 49.62,
      "end": 50.22
    },
    {
      "text": "elektrokardiyogram.",
      "start": 50.27,
      "end": 51.55
    }
  ],
