{
  "source": "elevenlabs:Xb7hH8MSUJpSbSDYk0k2/eleven_multilingual_v2",
  "audio": "videos/ekg/vo.wav",
  "phrases": [
    {
      "text": "Bu çizgiyi mutlaka görmüşsündür.",
      "start": 0.2,
      "end": 1.87
    },
    {
      "text": "Ama okumayı kimse öğretmedi.",
      "start": 1.95,
      "end": 3.27
    },
    {
      "text": "Peki bu çizgi ne anlatıyor?",
      "start": 3.5,
      "end": 4.85
    },
    {
      "text": "Peki bu çizgi nereden geliyor?",
      "start": 5.2,
      "end": 6.68
    },
    {
      "text": "Göğsünün ortasından, kalbinden.",
      "start": 6.8,
      "end": 8.59
    },
    {
      "text": "Kalbinin sağ üst köşesinde",
      "start": 8.79,
      "end": 10.08
    },
    {
      "text": "bir hücre kümesi ateşleniyor:",
      "start": 10.13,
      "end": 11.4
    },
    {
      "text": "dakikada altmış ila yüz kez.",
      "start": 11.58,
      "end": 13.32
    },
    {
      "text": "Dalga kulakçıklara yayılırken",
      "start": 13.55,
      "end": 14.75
    },
    {
      "text": "ilk küçük tepe çiziliyor: P.",
      "start": 14.9,
      "end": 16.85
    },
    {
      "text": "Peki ardından neden düz gidiyor?",
      "start": 17.2,
      "end": 19.07
    },
    {
      "text": "Dalga tek bir kapıda bekliyor:",
      "start": 19.16,
      "end": 20.72
    },
    {
      "text": "saniyenin onda biri kadar.",
      "start": 20.81,
      "end": 22.37
    },
    {
      "text": "Kan aşağı dolsun diye.",
      "start": 22.54,
      "end": 24.04
    },
    {
      "text": "Bu düzlük, PR bölümü.",
      "start": 24.12,
      "end": 25.74
    },
    {
      "text": "Peki o büyük sivri tepe ne?",
      "start": 26.2,
      "end": 27.52
    },
    {
      "text": "Kapı açılıyor, dalga hızlanıyor;",
      "start": 27.6,
      "end": 29.4
    },
    {
      "text": "karıncıklar birden ateşleniyor.",
      "start": 29.52,
      "end": 31.24
    },
    {
      "text": "İşte QRS: kalbin asıl vuruşu.",
      "start": 31.36,
      "end": 33.58
    },
    {
      "text": "Sonra toparlanma dalgası: T.",
      "start": 33.72,
      "end": 35.85
    },
    {
      "text": "Peki cihaz nasıl duyuyor?",
      "start": 36.2,
      "end": 37.68
    },
    {
      "text": "Elektrik cildine kadar ulaşıyor:",
      "start": 37.99,
      "end": 39.69
    },
    {
      "text": "kalem pilin binde birinden az.",
      "start": 39.82,
      "end": 41.36
    },
    {
      "text": "Cihazın akımı",
      "start": 41.49,
      "end": 42.18
    },
    {
      "text": "hissedemeyeceğin kadar küçük.",
      "start": 42.22,
      "end": 43.85
    },
    {
      "text": "Yani o çizgi,",
      "start": 44.2,
      "end": 45.06
    },
    {
      "text": "kalbinin her atışının kaydı.",
      "start": 45.11,
      "end": 46.76
    },
    {
      "text": "Adı \"kalbin elektrik yazısı\":",
      "start": 47.02,
      "end": 48.78
    },
    {
      "text": "elektrokardiyogram.",
      "start": 48.97,
      "end": 50.35
    }
  ],
