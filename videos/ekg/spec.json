          "Peki ardından neden düz gidiyor?",
          "Dalga tek bir kapıda bekliyor:",
          "saniyenin onda biri kadar.",
          "Kan aşağı dolsun diye.",
          "Bu düzlük, PR bölümü."
        ]
      },
      {
        "id": "qrs",
        "window": [26, 36],
        "phrases": [
          "Peki o büyük sivri tepe ne?",
          "Kapı açılıyor, dalga hızlanıyor;",
          "karıncıklar birden ateşleniyor.",
          "İşte QRS: kalbin asıl vuruşu.",
          "Sonra toparlanma dalgası: T."
        ]
      },
      {
        "id": "cihaz",
        "window": [36, 44],
        "phrases": [
          "Peki cihaz nasıl duyuyor?",
          "Elektrik cildine kadar ulaşıyor:",
          "kalem pilin binde birinden az.",
          "Cihazın akımı",
          "hissedemeyeceğin kadar küçük."
        ]
      },
      {
        "id": "final",
        "window": [44, 50.5],
        "phrases": ["Yani o çizgi,", "kalbinin her atışının kaydı.", "Adı \"kalbin elektrik yazısı\":", "elektrokardiyogram."]
      }
    ]
