  "sources": [
    {
      "id": "openstax",
      "claim": "Uyarı SA'dan AV düğümüne ~50 ms'de varır, AV düğümünde ~100 ms gecikir, His ve dallardan ~25 ms'de, Purkinje'den karıncıklara ~75 ms'de geçer; P kulakçıkların, QRS karıncıkların uyarılması, T karıncıkların toparlanmasıdır",
      "value": "50 / 150 / 175 / 250 ms",
      "url": "https://openstax.org/books/anatomy-and-physiology-2e/pages/19-2-cardiac-muscle-and-electrical-activity",
      "accessed": "2026-11-18",
      "status": "simplified",
      "note": "Zaman çizelgesi bölüm sürelerinin toplamıdır (250 ms); aynı kaynak toplamı ~225 ms diye de verir. Tipik değerler, kişiden kişiye değişir."
    },
    {
      "id": "klabunde-a003",
      "claim": "Kulakçıkların aktivasyonu SA ateşlemesinden ~0,09 sn sonra tamamlanır; AV gecikmesi kulakçık kasılmasının bitmesine zaman tanır",
      "value": "90 ms",
      "url": "https://cvphysiology.com/arrhythmias/a003",
      "accessed": "2026-11-18",
      "status": "simplified",
      "note": "'Kan aşağı dolsun diye' sadeleştirmesi: kulakçık kasılması karıncıkların dolmasını tamamlar."
    },
    {
      "id": "klabunde-a009",
      "claim": "P dalgası 80–100 ms, PR 0,12–0,20 sn, QRS 0,06–0,10 sn; QT 0,2–0,4 sn; kâğıt 25 mm/sn, 1 mV = 10 mm",
      "value": "PR 175 ms, QRS 75 ms, QT 325 ms",
      "url": "https://cvphysiology.com/arrhythmias/a009",
      "accessed": "2026-11-18",
      "status": "simplified",
      "note": "T dalgasının yeri (350–500 ms) QT aralığına oturtuldu; dalga genlikleri temsilidir."
    },
    {
      "id": "nhlbi",
      "claim": "Kalp göğsün ortasında, akciğerlerin yanındadır",
      "value": "göğsünün ortası",
      "url": "https://www.nhlbi.nih.gov/health/heart/anatomy",
      "accessed": "2026-11-18",
      "status": "verified"
    },
    {
      "id": "statpearls-sa",
      "claim": "SA düğümü sağ kulakçık duvarında, üst ana toplardamarın girişine yakındır",
      "value": "kalbinin sağ üst köşesi",
      "url": "https://www.statpearls.com/point-of-care/29042",
      "accessed": "2026-11-18",
      "status": "simplified",
      "note": "Hastanın sağı; ekranda '◀ SENİN SAĞIN' ile gösterilir."
    },
    {
      "id": "aha",
      "claim": "Dinlenirken normal nabız dakikada 60–100 atımdır",
      "value": "60–100",
      "url": "https://www.heart.org/en/health-topics/high-blood-pressure/the-facts-about-high-blood-pressure/all-about-heart-rate-pulse",
      "accessed": "2026-11-18",
      "status": "verified",
      "note": "Normal sinüs ritminde nabız SA düğümünün ateşleme hızına eşittir."
    },
    {
      "id": "jove",
      "claim": "Deride ölçülen EKG sinyali yaklaşık 1 mV'tur",
      "value": "≈1 mV",
      "url": "https://www.jove.com/v/10473",
      "accessed": "2026-11-18",
      "status": "simplified",
      "note": "Tipik tepe değeri; derivasyona göre ~0,5–4 mV."
    },
    {
      "id": "energizer",
      "claim": "AA alkalin kalem pilin nominal gerilimi 1,5 V'tur; 1 mV bunun binde birinden azdır",
      "value": "1,5 V",
      "url": "https://cdn.connectec.uk/Files/Products/Batteries/energizer_batteries/e91_aa_battery_datasheet.pdf",
      "accessed": "2026-11-18",
      "status": "verified",
      "note": "1 mV / 1,5 V ≈ 1/1500."
    },
    {
      "id": "iec-leakage",
      "claim": "IEC 60601-1, kalbe doğrudan uygulanabilen (CF) parçalarda hasta sızıntı akımını normal koşulda 10 µA ile sınırlar",
      "value": "≤ 10 µA",
      "url": "https://advancedenergy.com/en-us/about/news/blog/safety-requirements-in-medical-equipment-designing-for-bf-and-cf-classifications",
      "accessed": "2026-11-18",
      "status": "simplified",
      "note": "Standardın kendisi değil, üretici özetinden doğrulandı; EKG elektrotları CF ya da BF sınıfındadır (BF sınırı 100 µA)."
    },
    {
      "id": "osha",
      "claim": "Vücudun hissedebildiği akım eşiği yaklaşık 1 mA'dır (hafif karıncalanma)",
      "value": "≈1 mA",
      "url": "https://obis.osha.gov/dte/grant_materials/fy07/sh-16610-07/module_1-current_effect_on_human_body.doc",
      "accessed": "2026-11-18",
      "status": "simplified",
      "note": "OSHA eğitim materyali; bazı derlemeler eşiği 1–3 mA verir. 'Hissedemeyeceğin kadar küçük' bu karşılaştırmanın sadeleştirmesidir."
    },
    {
      "id": "dictionary-gram",
      "claim": "-gram eki Yunanca grámma'dan (yazılmış ya da çizilmiş şey) gelir",
      "value": "gram = yazı",
      "url": "https://www.dictionary.com/browse/-gram",
      "accessed": "2026-11-18",
      "status": "simplified",
      "note": "'Kalbin elektrik yazısı' serbest çeviri."
    },
    {
      "id": "dictionary-cardio",
      "claim": "cardio- Yunanca kardía'dan (kalp) gelir",
      "value": "kardiyo = kalp",
      "url": "https://www.dictionary.com/browse/cardio-",
      "accessed": "2026-11-18",
      "status": "verified"
    },
    {
      "id": "openstax-cycle",
      "claim": "Karıncıkların kasılması (sistol), EKG'de QRS ile gösterilen karıncık depolarizasyonunu izler",
      "value": "önce elektrik, sonra kasılma",
      "url": "https://openstax.org/books/anatomy-and-physiology-2e/pages/19-3-cardiac-cycle",
      "accessed": "2026-11-18",
      "status": "verified"
    }
  ],
