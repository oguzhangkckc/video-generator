      {
        "id": "kanca",
        "window": [0, 5.66],
        "phrases": ["Bu çizgiyi mutlaka görmüşsündür.", "Ama okumayı kimse öğretmedi.", "Bu çizgi ne anlatıyor?"]
      },
      {
        "id": "cihaz",
        "window": [5.66, 16.12],
        "phrases": [
          "Peki cihaz bunu nasıl duyuyor?",
          "Göğsündeki elektrotlarla.",
          "Kalbinin elektriği cildine ulaşıyor:",
          "gerilimi, kalem pilin binde birinden az.",
          "Cihazın kendi akımı ise",
          "hissedemeyeceğin kadar küçük."
        ]
      },
      {
        "id": "kaynak",
        "window": [16.12, 27.24],
        "phrases": [
          "Peki bu elektrik nereden geliyor?",
          "Kalbinin sağ üst köşesinden.",
          "Bir hücre kümesi ateşleniyor:",
          "dakikada altmış ila yüz kez.",
          "Dalga kulakçıklara yayılırken",
          "ilk küçük tepe çiziliyor: P dalgası."
        ]
      },
      {
        "id": "bekleme",
        "window": [27.24, 37.11],
        "phrases": [
          "Peki ardından neden düz gidiyor?",
          "Dalga tek bir kapıda bekliyor:",
          "saniyenin onda biri kadar.",
          "Kan aşağı dolsun diye.",
          "Bu düzlük, PR bölümü."
        ]
      },
      {
        "id": "qrs",
        "window": [37.11, 49.2],
        "phrases": [
          "Peki ya o büyük sivri tepe?",
          "Kapı açılıyor, dalga hızlanıyor;",
          "karıncıklar birden uyarılıyor.",
          "İşte QRS: asıl vuruşun işareti.",
          "Kas bir an sonra kasılıyor.",
          "Sonra T dalgası geliyor: toparlanma."
        ]
      },
      {
        "id": "final",
        "window": [49.2, 57.15],
        "phrases": [
          "Küçük tepe: kulakçıklar,",
          "düzlük: bekleme,",
          "sivri tepe: karıncıklar,",
          "son dalga: toparlanma.",
          "Bunun adı:",
          "elektrokardiyogram."
        ]
