  "sources": [
    {
      "claim": "GPS uyduları yaklaşık 20.200 km yükseklikte",
      "value": "20.200 km",
      "url": "https://www.gps.gov/systems/gps/space",
      "accessed": "2026-11-18",
      "status": "verified"
    },
    {
      "claim": "Takımyıldızda otuzdan fazla çalışan uydu var",
      "value": "30+",
      "url": "https://www.gps.gov/systems/gps/space",
      "accessed": "2026-11-18",
      "status": "verified",
      "note": "Sayı zamanla değişir; 2023'te 31 çalışan uydu. En az 24 garanti ediliyor."
    },
    {
      "claim": "Uydular saatte ~14.000 km hızla dönüyor",
      "value": "14.000 km/sa",
      "url": "https://www.sciencing.com/how-fast-do-gps-satellites-travel-12213923",
      "accessed": "2026-11-18",
      "status": "simplified",
      "note": "≈3,87 km/s ≈ 13.900 km/sa, Dünya merkezine göre."
    },
    {
      "claim": "Her uydu 12 saatte bir tur atıyor",
      "value": "12 saatte 1 tur",
      "url": "https://www.gps.gov/systems/gps/space",
      "accessed": "2026-11-18",
      "status": "simplified",
      "note": "Gerçek periyot ≈11 sa 58 dk (günde iki tur)."
    },
    {
      "claim": "Sinyal yaklaşık 70 milisaniyede ulaşıyor",
      "value": "≈0,070 sn",
      "url": "https://physics.nist.gov/cgi-bin/cuu/Value?c",
      "accessed": "2026-11-18",
      "status": "simplified",
      "note": "20.200 km / 299.792 km/s ≈ 67 ms (tepedeki uydu); ufka yakın uydularda ~85 ms'ye çıkar."
    },
    {
      "claim": "Işık hızı ≈ 300.000 km/s",
      "value": "299.792,458 km/s",
      "url": "https://physics.nist.gov/cgi-bin/cuu/Value?c",
      "accessed": "2026-11-18",
      "status": "verified"
    },
    {
      "claim": "Saatte 1 µs hata ≈ 300 m uzaklık hatası",
      "value": "≈300 m",
      "url": "https://physics.nist.gov/cgi-bin/cuu/Value?c",
      "accessed": "2026-11-18",
      "status": "simplified",
      "note": "c × 1 µs = 299,8 m uzaklık hatası; haritadaki konum hatası uydu geometrisine göre değişir."
    }
  ],
