{
  "title": "Telefonun konumu nasıl buluyor?",
  "lang": "tr",
  "durationSec": 30,
  "voiceover": {
    "audio": "videos/gps-pilot/vo.wav",
    "voice": "ElevenLabs Alice (Xb7hH8MSUJpSbSDYk0k2), eleven_multilingual_v2",
    "sections": [
      {
        "id": "kanca",
        "window": [0, 6],
        "phrases": [
          "Cebinde bir uydu alıcısı var.",
          "Ama uydular seni",
          "görmüyor bile.",
          "Peki telefonun nerede",
          "olduğunu nasıl biliyor?"
        ]
      },
      {
        "id": "uydular",
        "window": [6, 15],
        "phrases": [
          "Yirmi bin kilometre yukarıda,",
          "otuzdan fazla uydu",
          "saatte on dört bin",
          "kilometreyle dönüyor.",
          "Hepsi durmadan",
          "aynı şeyi fısıldıyor:"
        ]
      },
      {
        "id": "sinyal",
        "window": [15, 24],
        "phrases": [
          "“Saat şu an bu,",
          "ben de buradayım.”",
          "Bu fısıltı sana",
          "ışık hızıyla,",
          "yaklaşık yetmiş",
          "milisaniyede ulaşıyor.",
          "Telefonun bu gecikmeden",
          "uzaklığı hesaplıyor."
        ]
      },
      {
        "id": "hata",
        "window": [24, 30],
        "phrases": [
          "Ama saat",
          "bir mikrosaniye şaşarsa,",
          "haritada üç yüz metre kayarsın.",
          "Peki ya uydudaki",
          "saatler yanlışsa?"
        ]
      }
    ]
  },
