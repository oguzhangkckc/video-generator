{
  "source": "elevenlabs:Xb7hH8MSUJpSbSDYk0k2/eleven_multilingual_v2",
  "audio": "videos/gps-pilot/vo.wav",
  "phrases": [
    {
      "text": "Cebinde bir uydu alıcısı var.",
      "start": 0.2,
      "end": 1.57
    },
    {
      "text": "Ama uydular seni",
      "start": 1.78,
      "end": 2.58
    },
    {
      "text": "görmüyor bile.",
      "start": 2.63,
      "end": 3.36
    },
    {
      "text": "Peki telefonun nerede",
      "start": 3.49,
      "end": 4.41
    },
    {
      "text": "olduğunu nasıl biliyor?",
      "start": 4.45,
      "end": 5.68
    },
    {
      "text": "Yirmi bin kilometre yukarıda,",
      "start": 6.2,
      "end": 7.91
    },
    {
      "text": "otuzdan fazla uydu",
      "start": 7.98,
      "end": 9.32
    },
    {
      "text": "saatte on dört bin",
      "start": 9.37,
      "end": 10.74
    },
    {
      "text": "kilometreyle dönüyor.",
      "start": 10.79,
      "end": 12.04
    },
    {
      "text": "Hepsi durmadan",
      "start": 12.37,
      "end": 13.38
    },
    {
      "text": "aynı şeyi fısıldıyor:",
      "start": 13.49,
      "end": 14.85
    },
    {
      "text": "“Saat şu an bu,",
      "start": 15.2,
      "end": 16.08
    },
    {
      "text": "ben de buradayım.”",
      "start": 16.1,
      "end": 16.98
    },
    {
      "text": "Bu fısıltı sana",
      "start": 17.21,
      "end": 18.01
    },
    {
      "text": "ışık hızıyla,",
      "start": 18.06,
      "end": 18.85
    },
    {
      "text": "yaklaşık yetmiş",
      "start": 19.02,
      "end": 19.89
    },
    {
      "text": "milisaniyede ulaşıyor.",
      "start": 19.96,
      "end": 21.14
    },
    {
      "text": "Telefonun bu gecikmeden",
      "start": 21.31,
      "end": 22.43
    },
    {
      "text": "uzaklığı hesaplıyor.",
      "start": 22.51,
      "end": 23.85
    },
    {
      "text": "Ama saat",
      "start": 24.2,
      "end": 24.67
    },
    {
      "text": "bir mikrosaniye şaşarsa,",
      "start": 24.72,
      "end": 26
    },
    {
      "text": "haritada üç yüz metre kayarsın.",
      "start": 26.15,
      "end": 27.84
    },
    {
      "text": "Peki ya uydudaki",
      "start": 27.9,
      "end": 28.77
    },
    {
      "text": "saatler yanlışsa?",
      "start": 28.81,
      "end": 29.85
    }
  ],
